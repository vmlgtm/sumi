{
  "manifest_version": 3,
  "name": "Sumi (墨) - Notes",
  "version": "1.0.0",
  "description": "Ultra-fast, distraction-free, local-first notes for your browser new tab.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
